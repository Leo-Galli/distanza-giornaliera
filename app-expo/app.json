{
  "expo": {
    "name": "Distanza giornaliera",
    "slug": "distanza-giornaliera",
    "scheme": "distanzagiornaliera",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b1019",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.example.distanzagiornaliera",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "L'app usa il GPS per misurare la distanza percorsa durante la giornata.",
        "NSMotionUsageDescription": "L'app usa il contapassi del telefono per contare i passi di oggi."
      }
    },
    "android": {
      "package": "org.example.distanzagiornaliera",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACTIVITY_RECOGNITION"
      ],
      "predictiveBackGestureEnabled": false,
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "L'app usa il GPS per misurare la distanza percorsa durante la giornata."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "L'app usa il contapassi del telefono per contare i passi di oggi."
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#4DAE3C"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b6068bc5-37d9-4474-be29-1f81b9aa9399"
      }
    },
    "owner": "leogalli"
  }
}
